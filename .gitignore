# dependances
node_modules/

# secrets : jamais dans le depot
.env
.env.*
!.env.example
dotenv
*.key

# images : pas de Git LFS (decision de Fabrice). Elles vivent dans images/,
# sur la machine, et a terme dans le stockage de la base.
images/

# fichiers de travail d'un soir de prospection : se refabriquent, jamais
# la verite (registre.json et en-ligne.json restent versionnes)
prospection/a-verifier.json
prospection/sites-du-jour.json

# sites fabriques et app construite : ils se refabriquent depuis le depot
app/dist/
# copies construites pour un contre-essai (SITO_APP_DIST=app/dist-casse)
app/dist-*/
sites/
flotte/
sortie/

# archives et journaux
*.zip
*.log
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
# etat de la boucle autonome de Claude Code (propre a chaque machine)
.claude/boucle.json
.claude/budget.json
.claude/autonome.json
# journaux des lancements
app.log
claude-autonome.log
installation.log
# captures et journaux du serveur Playwright (outil MCP) : temporaires
.playwright-mcp/
# depot temporaire de l outillage avant installation (lanceurs/INSTALLER_OUTILLAGE.bat)
_installation/
