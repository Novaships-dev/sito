# Modèle du fichier .env du service Sitô (à la racine du dépôt).
# Copier en .env et remplir. Le .env n'est JAMAIS versionné (.gitignore) et
# Claude ne l'ouvre pas : les scripts le lisent eux-mêmes (scripts/env.mjs).
# Une ligne vide = pas encore fourni ; le script qui en a besoin s'arrête et le dit.
# L'app a son propre modèle : app/.env.example (clé PUBLIQUE seulement).

# ---- Supabase (projet sito, Paris) ------------------------------------------
# Tableau de bord Supabase > Project Settings > API Keys.
SUPABASE_URL=https://magxzrpboyrzguuocjgj.supabase.co
# Clé SECRÈTE (sb_secret_...) : contourne tous les droits. Service seulement.
SUPABASE_CLE_SERVICE=
# Clé PUBLIQUE (sb_publishable_...) : celle de l'app ; le formulaire des sites
# d'abonnés la porte dans la page (T11). Pas un secret.
SUPABASE_CLE_PUBLIQUE=sb_publishable_Soi-8VlJuoGQCuctPooaOw_0ku20F8b
# Adresse qui reçoit les codes de connexion du compte d'essai (memoire/comptes-essai.md).
SITO_COMPTE_ESSAI_COURRIEL=

# ---- GitHub (lire l'état de la CI d'un dépôt privé) ------------------------
# Facultatif : si Git a déjà un identifiant enregistré pour github.com (c'est le
# cas dès le premier `git push` réussi), scripts/ci-github.mjs s'en sert et
# cette ligne reste vide. Sinon : github.com > Settings > Developer settings >
# Personal access tokens > Fine-grained, dépôt sito, « Actions : Read-only ».
GITHUB_JETON=

# ---- Cloudflare (hébergement des sites) : étape 7 du plan ------------------
CLOUDFLARE_COMPTE_ID=
CLOUDFLARE_JETON_API=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_KV_ADRESSES_ID=
CLOUDFLARE_R2_SITES=

# ---- Domaines : Gandi API v5 : étape 14 ------------------------------------
GANDI_JETON=
# true tant qu'on essaie sur le bac à sable de Gandi
GANDI_BAC_A_SABLE=true

# ---- Stripe : étape 15 (clés de TEST d'abord) -------------------------------
STRIPE_CLE_SECRETE=
STRIPE_SECRET_WEBHOOK=
STRIPE_PRIX_MENSUEL=
STRIPE_PRIX_ANNUEL=

# ---- E-mail des codes de connexion (Brevo ou équivalent) : étape 12 --------
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=

# ---- Statistiques : Umami hébergé : étape 11 -------------------------------
UMAMI_URL=
UMAMI_JETON=

# ---- Google Business Profile : étape 20 ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé de chiffrement des jetons Google avant stockage (32 octets, base64).
GOOGLE_CLE_CHIFFREMENT=
